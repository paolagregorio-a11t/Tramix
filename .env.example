# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx          # resend.com > API Keys
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx   # resend.com > Audiences (the waitlist)
EMAIL_FROM="Cuotio <hola@cuotio.es>"    # must belong to a domain verified in Resend
EMAIL_REPLY_TO=hola@cuotio.es           # optional
CONTACT_EMAIL=hola@tu-dominio.com            # shown in the email footer
EMAIL_SENDER_NAME="El equipo de Cuotio"
SITE_URL=https://cuotio.es              # no trailing slash; used for logo and links in emails
UNSUBSCRIBE_SECRET=                          # any long random string: openssl rand -hex 32

# --- Asistente de IA (opcional). Cualquier API compatible con OpenAI. Mira los límites gratuitos vigentes del proveedor. ---
AI_API_KEY=                                  # Google AI Studio: aistudio.google.com/apikey
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   # Groq: https://api.groq.com/openai/v1
AI_MODEL=gemini-flash-lite-latest            # usa un alias "-latest": los nombres fijos caducan

# --- Estadísticas sin cookies (opcional). Umami Cloud, región UE. Ver DEPLOY.md, apartado 6. ---
VITE_UMAMI_WEBSITE_ID=                       # umami.is > Settings > Websites > Website ID (público)
VITE_UMAMI_SRC=https://cloud.umami.is/script.js   # solo si tu código de seguimiento usa otra dirección

# --- Cuentas y base de datos (Supabase, región Central EU / Frankfurt). Ver DEPLOY.md, apartado 7. ---
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co   # Project Settings > API > Project URL (pública)
VITE_SUPABASE_ANON_KEY=                          # Project Settings > API > anon / publishable key (pública)
SUPABASE_SERVICE_ROLE_KEY=                       # SECRETA: service_role / secret key. Solo en Vercel, nunca en el código ni en el chat

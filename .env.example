# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx          # resend.com > API Keys
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx   # resend.com > Audiences (the waitlist)
EMAIL_FROM="Tramix <hola@tu-dominio.com>"    # must belong to a domain verified in Resend
EMAIL_REPLY_TO=hola@tu-dominio.com           # optional
CONTACT_EMAIL=hola@tu-dominio.com            # shown in the email footer
EMAIL_SENDER_NAME="El equipo de Tramix"
SITE_URL=https://tu-dominio.com              # no trailing slash; used for logo and links in emails
UNSUBSCRIBE_SECRET=                          # any long random string: openssl rand -hex 32

# --- Asistente de IA (opcional). Cualquier API compatible con OpenAI. Mira los límites gratuitos vigentes del proveedor. ---
AI_API_KEY=                                  # Groq: console.groq.com/keys  |  Gemini: aistudio.google.com/apikey
AI_BASE_URL=https://api.groq.com/openai/v1   # Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=llama-3.3-70b-versatile             # Gemini: gemini-2.5-flash
